{
	// Cloudflare Workers com static assets: serve dist/ e aplica public/_headers.
	// Deploy pelo GitHub Actions (deploy.yml) com CLOUDFLARE_API_TOKEN limitado a Workers.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ai-ops-sec",
	"compatibility_date": "2026-09-01",
	// Agent-Ready Stack (25-Set-2026): o Worker corre antes dos assets para registar bots de IA por
	// etapa, servir o MCP em /mcp e exportar para a Torre. Estado num Durable Object com SQLite
	// (plano Free), sem D1 nem KV: nada a criar fora do deploy.
	"main": "src/worker/index.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// O Worker corre primeiro nas páginas e nos ficheiros para máquinas (é aí que se mede quem lê o quê);
		// os assets estáticos vão directos do cache. Cada pedido que passa pelo Worker e vem de um bot é uma
		// linha escrita no Durable Object, e no plano Free são 100 mil linhas por dia: com `true` um crawler
		// a puxar CSS, fontes e imagens gastava esse orçamento e os contactos reais perdiam-se em silêncio.
		"run_worker_first": ["/*", "!/_astro/*", "!/pagefind/*", "!/js/*", "!/og/*", "!/favicon.svg"],
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash"
	},
	"durable_objects": { "bindings": [{ "name": "AGENT_OBS", "class_name": "AgentObs" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgentObs"] }],
	"vars": {
		"SITE_URL": "https://andresilvalab.com",
		// sha256 do token de leitura do export, não o token: o Worker compara o hash do header com este
		// valor e nunca guarda o segredo. O token vive no cofre do autor; rodar = novo hash + deploy.
		"OPS_TOKEN_HASH": "276ee3858e52c0bf2297adb62b56624c8baae2024ae2cbcd52cac8d90c5a61aa" // gitleaks:allow
	},
	// Só o domínio canónico. www e andresilvalab.dev fazem 301 por Redirect Rules na zona
	// (o _redirects dos static assets só aceita origens relativas, não domínios).
	"routes": [{ "pattern": "andresilvalab.com", "custom_domain": true }],
	"workers_dev": false,
	"observability": { "enabled": false }
}
