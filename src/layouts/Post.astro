---
import { render } from 'astro:content';
import Base from './Base.astro';
import PostFooter from '../components/PostFooter.astro';
import Related from '../components/Related.astro';
import Faq from '../components/Faq.astro';
import TraceRail from '../components/TraceRail.astro';
import Callout from '../components/mdx/Callout.astro';
import Redacted from '../components/mdx/Redacted.astro';
import InlineAnimation from '../components/mdx/InlineAnimation.astro';
import Chain from '../components/mdx/Chain.astro';
import Cards from '../components/mdx/Cards.astro';
import { Image } from 'astro:assets';
import CoverAnimation from '../components/CoverAnimation.astro';
import type { Locale } from '../consts';
import { href, t } from '../lib/i18n';
import { areaOf } from '../lib/areas';
import { getTranslation, slugOf, type Post } from '../lib/posts';
import { articleLd, breadcrumbLd, faqLd } from '../lib/seo';

interface Props {
	post: Post;
}
const { post } = Astro.props;
const d = post.data;
const locale: Locale = d.lang;
const ui = t(locale);
const { Content, headings } = await render(post);
const translation = await getTranslation(post);
const slug = slugOf(post);
const url = new URL(Astro.url.pathname, Astro.site).toString();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const og = new URL(`${base}/og/${locale}/${slug}.png`, Astro.site).toString();
const jsonLd = [
	articleLd(post, url, og),
	breadcrumbLd([
		{ name: 'AI Ops Sec', url: new URL(href(locale, ''), Astro.site).toString() },
		{ name: ui.nav_blog, url: new URL(href(locale, 'blog'), Astro.site).toString() },
		{ name: d.title, url },
	]),
	...[faqLd(post, url)].filter(Boolean),
];
const alternatePath = translation ? `blog/${slugOf(translation)}` : undefined;
const area = areaOf(d.area);
---

<Base
	locale={locale}
	title={d.title}
	description={d.description}
	image={og}
	type="article"
	alternatePath={alternatePath}
	published={d.pubDate}
	modified={d.updatedDate ?? d.pubDate}
	jsonLd={jsonLd}
	noindex={d.status !== 'published'}
	canonical={d.canonical}
>
	<article class="post" data-pagefind-body>
		<header class="head reveal">
			<p class="seq-label">//{area.seq} {area.name[locale]}{d.series && <> · {ui.in_series}: {d.series}</>}{d.status !== 'published' && <> · {d.status}</>}</p>
			<h1>{d.title}</h1>
			<p class="lede">{d.description}</p>
		</header>
		<div class="grid">
			<TraceRail post={post} headings={headings} translation={translation} />
			<div class="body reveal" style="--i:3">
				{d.cover && !d.heroImage && <div class="hero-cover"><CoverAnimation id={d.cover} variant="hero" /></div>}
				{d.heroImage && (
					<figure>
						<Image src={d.heroImage} alt={d.heroAlt ?? ''} width={1200} densities={[1, 2]} loading="eager" />
						{d.heroAlt && <figcaption>{d.heroAlt}</figcaption>}
					</figure>
				)}
				<div class="prose">
					<Content components={{ Callout, Redacted, InlineAnimation, Chain, Cards }} />
				</div>
				<Faq post={post} />
				<Related post={post} />
				<PostFooter post={post} url={url} />
			</div>
		</div>
	</article>
</Base>

<style>
	.head {
		max-width: 52rem;
		margin-bottom: clamp(2rem, 4vw, 3.5rem);
	}
	.head h1 {
		margin: 0.6rem 0 1rem;
	}
	.grid {
		display: grid;
		grid-template-columns: var(--rail) minmax(0, 1fr);
		gap: 3rem;
		align-items: start;
	}
	/* filhos de grelha nascem com min-width:auto: um slug longo na rail alargava a página inteira no telemóvel */
	.grid > :global(*) {
		min-width: 0;
		max-width: 100%;
	}
	figure {
		margin: 0 0 2rem;
	}
	.hero-cover {
		margin: 0 0 2rem;
		max-width: var(--measure);
	}
	figure img {
		width: 100%;
		height: auto;
		border: 1px solid var(--line);
		border-radius: 12px;
	}
	figcaption {
		font: 400 11.5px var(--font-mono);
		color: var(--muted);
		margin-top: 0.6em;
	}
	@media (max-width: 960px) {
		.grid {
			grid-template-columns: minmax(0, 1fr);
			gap: 2rem;
		}
	}
</style>
