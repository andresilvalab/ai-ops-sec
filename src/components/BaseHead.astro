---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { AUTHOR, type Locale } from '../consts';
import { href, otherLocale, site } from '../lib/i18n';
import { CSP, THEME_SCRIPT } from '../lib/csp';

interface Props {
	locale: Locale;
	title: string;
	description: string;
	image?: string;           // URL absoluto da imagem OG
	type?: 'website' | 'article';
	alternatePath?: string;   // caminho (relativo ao locale) da tradução, se existir
	published?: Date;
	modified?: Date;
	jsonLd?: object[];
	noindex?: boolean;
	canonical?: string;
}

const { locale, title, description, type = 'website', alternatePath, published, modified, jsonLd = [], noindex = false } = Astro.props;
const s = site(locale);
const canonical = Astro.props.canonical ? new URL(Astro.props.canonical) : new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const image = Astro.props.image ?? new URL(`${base}/og/default-${locale}.png`, Astro.site).toString();
const other = otherLocale(locale);
const rss = new URL(href(locale, 'rss.xml'), Astro.site);
const fullTitle = title === s.title ? `${s.title}: ${s.tagline}` : `${title} · ${s.title}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="dark light" />
<meta name="theme-color" content="#1a1c24" />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<!-- CSP de reserva para alojamentos sem cabeçalhos (GitHub Pages). A versão completa vai em public/_headers. -->
<meta http-equiv="Content-Security-Policy" content={CSP} />
<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
<link rel="sitemap" href={`${base}/sitemap-index.xml`} />
<link rel="alternate" type="application/rss+xml" title={`${s.title} (${locale.toUpperCase()})`} href={rss} />
<link rel="author" href={AUTHOR.github} />
{/* Verificacao de identidade: o Mastodon e o Bluesky marcam o site como verificado quando ele aponta de volta. */}
<link rel="me" href="https://infosec.exchange/@andre_lab" />
<link rel="me" href="https://bsky.app/profile/andresilvalab.com" />
<link rel="license" href="https://creativecommons.org/licenses/by/4.0/" />
<meta name="generator" content={Astro.generator} />
{noindex && <meta name="robots" content="noindex,follow" />}

<Font cssVariable="--font-sans" preload />
<Font cssVariable="--font-mono" preload />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={AUTHOR.name} />
<link rel="canonical" href={canonical} />
{alternatePath && <link rel="alternate" hreflang={site(other).locale} href={new URL(href(other, alternatePath), Astro.site)} />}
{alternatePath && <link rel="alternate" hreflang={s.locale} href={canonical} />}
{alternatePath && <link rel="alternate" hreflang="x-default" href={locale === 'en' ? canonical : new URL(href('en', alternatePath), Astro.site)} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={s.title} />
<meta property="og:locale" content={locale === 'pt' ? 'pt_PT' : 'en_US'} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{published && <meta property="article:published_time" content={published.toISOString()} />}
{modified && <meta property="article:modified_time" content={modified.toISOString()} />}
{type === 'article' && <meta property="article:author" content={AUTHOR.name} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

{jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}

<!-- Tema sem flash: lê a preferência guardada antes da primeira pintura. Autorizado na CSP por hash. -->
<script is:inline set:html={THEME_SCRIPT} />
