---
import Base from '../../layouts/Base.astro';
import PostRow from '../PostRow.astro';
import type { Locale } from '../../consts';
import { href, otherLocale, site, t } from '../../lib/i18n';
import { getPosts, getTags } from '../../lib/posts';

interface Props {
	locale: Locale;
	tag?: string;
}
const { locale, tag } = Astro.props;
const ui = t(locale);
const tags = await getTags(locale);
const posts = tag ? (await getPosts(locale)).filter((p) => p.data.tags.includes(tag)) : [];
/* hreflang só quando a tag existe na outra língua: até 28-Set-2026 apontava sempre, e os bots seguiam para
   404 (/tags/agents/, /en/tags/interpretabilidade/). As páginas de tag ficam noindex,follow: são navegação
   interna, não conteúdo, e levavam um terço do crawl dos bots de resposta. */
const tagInOther = tag ? (await getTags(otherLocale(locale))).has(tag) : true;
---

<Base
	locale={locale}
	title={tag ? `${ui.tagged} ${tag}` : ui.tags_title}
	description={site(locale).description}
	alternatePath={tagInOther ? (tag ? `tags/${tag}` : 'tags') : undefined}
	noindex={!!tag}
>
	<header class="head">
		<p class="seq-label">//{ui.nav_tags}</p>
		<h1>{tag ? <>{ui.tagged} <em>#{tag}</em></> : ui.tags_title}</h1>
	</header>
	<div class="cloud">
		{[...tags.entries()].map(([name, n]) => (
			<a class:list={['chip', { ok: name === tag }]} href={href(locale, `tags/${name}`)}>#{name} <b>{n}</b></a>
		))}
		{tags.size === 0 && <p class="empty">{ui.no_posts}</p>}
	</div>
	{tag && <section class="card" style="--i:1"><ul class="rows">{posts.map((p, i) => <PostRow post={p} index={i + 2} />)}</ul></section>}
</Base>

<style>
	.head {
		margin-bottom: 1.2rem;
	}
	.head h1 {
		margin-top: 0.5rem;
	}
	.cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 1.6rem;
	}
	.empty {
		color: var(--muted);
		margin: 0;
	}
</style>
