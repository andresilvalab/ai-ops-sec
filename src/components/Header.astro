---
import type { Locale } from '../consts';
import { href, otherLocale, site, t } from '../lib/i18n';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
	locale: Locale;
	alternatePath?: string;
}
const { locale, alternatePath } = Astro.props;
const ui = t(locale);
const s = site(locale);
const other = otherLocale(locale);
const path = Astro.url.pathname;
const isActive = (p: string) => path.startsWith(href(locale, p));
---

<header class="site-header">
	<div class="wrap bar">
		<a class="brand" href={href(locale, '')} aria-label={s.title}>
			<span class="live-dot" aria-hidden="true"></span>
			<span class="brand-name">André Silva <em>Lab</em></span>
		</a>
		<nav aria-label="Principal">
			<a href={href(locale, 'areas')} class:list={{ active: isActive('areas') }}>{ui.nav_areas}</a>
			<a href={href(locale, 'blog')} class:list={{ active: isActive('blog') }}>{ui.nav_blog}</a>
			<a href={href(locale, 'tags')} class:list={{ active: isActive('tags') }}>{ui.nav_tags}</a>
			<a href={href(locale, 'scanner')} class:list={{ active: isActive('scanner') }}>{ui.nav_scanner}</a>
			<a href={href(locale, 'about')} class:list={{ active: isActive('about') }}>{ui.nav_about}</a>
		</nav>
		<div class="tools">
			<a class="iconbtn lang" href={href(other, alternatePath ?? '')} title={ui.lang_switch} lang={other}>{ui.lang_switch_short}</a>
			<a class="iconbtn" href={href(locale, 'search')} title={ui.search} aria-label={ui.search}>
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
			</a>
			<ThemeToggle label={ui.theme} />
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--bg) 82%, transparent);
		backdrop-filter: saturate(1.2) blur(10px);
		border-bottom: 1px solid var(--line);
	}
	.bar {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		min-height: 3.5rem;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		white-space: nowrap;
		font-weight: 600;
		font-size: 1.02rem;
		letter-spacing: -0.01em;
	}
	.brand em {
		font-style: normal;
		color: var(--accent);
	}
	nav {
		display: flex;
		gap: 0.25rem;
		margin-left: auto;
		font: 500 12px var(--font-mono);
	}
	nav a {
		color: var(--muted);
		padding: 6px 10px;
		border-radius: 8px;
	}
	nav a:hover {
		color: var(--fg);
	}
	nav a.active {
		background: var(--accent-soft);
		color: var(--fg);
	}
	.tools {
		display: flex;
		gap: 0.4rem;
		align-items: center;
	}
	.lang {
		font: 600 11px var(--font-mono);
	}
	@media (max-width: 640px) {
		.bar {
			flex-wrap: wrap;
			gap: 0.5rem 1rem;
			padding: 0.6rem 0;
		}
		.tools {
			margin-left: auto;
		}
		nav {
			order: 3;
			flex-basis: 100%;
			margin-left: 0;
			gap: 0.1rem;
			font-size: 11px;
		}
	}
</style>
