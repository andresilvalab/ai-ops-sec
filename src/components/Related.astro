---
/* Leituras relacionadas no fim de cada artigo: 3 da mesma língua, com garantia de que nenhum artigo fica
   sem ligação interna (ver relatedMap em lib/posts). */
import type { Locale } from '../consts';
import { areaOf } from '../lib/areas';
import { href, t } from '../lib/i18n';
import { relatedMap, slugOf, type Post } from '../lib/posts';
interface Props { post: Post }
const { post } = Astro.props;
const locale: Locale = post.data.lang;
const ui = t(locale);
const items = (await relatedMap()).get(post.id) ?? [];
---
{items.length > 0 && (
	<section class="card related" aria-labelledby="related" style="--i:2">
		<div class="stitle"><span class="idx">//</span><h2 id="related">{ui.related_title}</h2><span class="rule"></span><span class="hint">{items.length}</span></div>
		<ul>
			{items.map((r) => (
				<li>
					<span class="mono area">{areaOf(r.data.area).name[locale]}</span>
					<a href={href(locale, `blog/${slugOf(r)}`)}>{r.data.title}</a>
				</li>
			))}
		</ul>
	</section>
)}
<style>
	.related { margin-top: 3rem; max-width: var(--measure); }
	ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
	li { display: grid; gap: 2px; }
	.area { font-size: 10.5px; color: var(--muted); }
	a { color: var(--fg); text-decoration: none; font-weight: 500; }
	a:hover { color: var(--accent); }
</style>
